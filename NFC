<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">

<title>R.G's Backyard Bistro — NFC Profile</title>

<style>
* {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
}

body {
    font-family: Arial, Helvetica, sans-serif;
    background: #f5f1e8;
    color: #29251f;
}

button,
input,
textarea {
    font: inherit;
}

.workspace {
    min-height: 100vh;
    display: grid;
    grid-template-columns: 360px 1fr;
}

/* =========================
   EDITOR
========================= */

.editor {
    background: #fffdf8;
    border-right: 1px solid #ddd5c8;
    padding: 28px;
    overflow-y: auto;
}

.editor h1 {
    font-size: 24px;
    margin-bottom: 8px;
}

.editor-subtitle {
    color: #81796d;
    font-size: 14px;
    margin-bottom: 28px;
}

.field {
    margin-bottom: 18px;
}

.field label {
    display: block;
    font-size: 13px;
    font-weight: 700;
    margin-bottom: 7px;
}

.field input,
.field textarea {
    width: 100%;
    border: 1px solid #d8d0c3;
    border-radius: 10px;
    padding: 11px 12px;
    background: white;
    outline: none;
}

.field textarea {
    min-height: 80px;
    resize: vertical;
}

.field input:focus,
.field textarea:focus {
    border-color: #b49a6a;
}

.switch-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 12px 0;
    border-bottom: 1px solid #eee8de;
}

.switch-row label {
    font-size: 14px;
    font-weight: 600;
}

.switch {
    position: relative;
    width: 45px;
    height: 24px;
}

.switch input {
    opacity: 0;
    width: 0;
    height: 0;
}

.slider {
    position: absolute;
    inset: 0;
    background: #ccc;
    border-radius: 30px;
    cursor: pointer;
    transition: .2s;
}

.slider:before {
    content: "";
    position: absolute;
    width: 18px;
    height: 18px;
    left: 3px;
    top: 3px;
    background: white;
    border-radius: 50%;
    transition: .2s;
}

.switch input:checked + .slider {
    background: #9d7b42;
}

.switch input:checked + .slider:before {
    transform: translateX(21px);
}

.actions {
    display: flex;
    gap: 10px;
    margin-top: 25px;
}

.actions button {
    flex: 1;
    border: none;
    border-radius: 10px;
    padding: 12px;
    cursor: pointer;
    font-weight: 700;
}

.save-btn {
    background: #29251f;
    color: white;
}

.reset-btn {
    background: #ebe4d8;
    color: #29251f;
}

.nfc-box {
    margin-top: 22px;
    padding: 15px;
    background: #f4eee3;
    border-radius: 12px;
}

.nfc-box strong {
    display: block;
    margin-bottom: 8px;
}

.nfc-url {
    font-size: 12px;
    word-break: break-all;
    color: #75664f;
}

.copy-btn {
    margin-top: 10px;
    width: 100%;
    padding: 10px;
    border: none;
    border-radius: 9px;
    background: #9d7b42;
    color: white;
    cursor: pointer;
    font-weight: bold;
}

/* =========================
   PREVIEW
========================= */

.preview-area {
    display: flex;
    justify-content: center;
    align-items: center;
    padding: 35px;
    background:
        radial-gradient(
            circle at top,
            #fffaf0,
            #eee7da
        );
}

.phone {
    width: 390px;
    max-width: 100%;
    height: 780px;
    background: #111;
    border-radius: 42px;
    padding: 10px;
    box-shadow:
        0 25px 60px rgba(0,0,0,.25);
}

.phone-screen {
    height: 100%;
    overflow: hidden;
    border-radius: 34px;
    background: #f7f1e7;
    position: relative;
}

.profile {
    min-height: 100%;
    padding: 28px 20px;
    position: relative;
    background:
        linear-gradient(
            rgba(20,15,10,.45),
            rgba(20,15,10,.72)
        ),
        url("image1.png") center/cover no-repeat;
}

.profile-content {
    position: relative;
    z-index: 2;
    min-height: 100%;
    display: flex;
    flex-direction: column;
}

.brand {
    text-align: center;
    color: white;
    padding-top: 40px;
}

.brand h2 {
    font-family: Georgia, serif;
    font-size: 30px;
    line-height: 1.1;
}

.brand p {
    margin-top: 10px;
    font-size: 14px;
    color: #eee6d8;
    line-height: 1.5;
}

.social-buttons {
    margin-top: 35px;
    display: flex;
    flex-direction: column;
    gap: 13px;
}

.social-button {
    width: 100%;
    min-height: 62px;
    border-radius: 18px;
    display: flex;
    align-items: center;
    padding: 10px 18px;
    text-decoration: none;
    background: rgba(255,255,255,.94);
    color: #27231e;
    box-shadow: 0 8px 20px rgba(0,0,0,.16);
    transition: transform .2s, box-shadow .2s;
}

.social-button:hover {
    transform: translateY(-2px);
    box-shadow: 0 12px 25px rgba(0,0,0,.22);
}

.social-icon {
    width: 42px;
    height: 42px;
    object-fit: contain;
    margin-right: 14px;
}

.social-text {
    flex: 1;
}

.social-title {
    font-size: 15px;
    font-weight: 800;
}

.social-description {
    font-size: 11px;
    color: #81796d;
    margin-top: 3px;
}

.arrow {
    font-size: 20px;
    color: #9d7b42;
}

.footer {
    margin-top: auto;
    text-align: center;
    padding-top: 35px;
    color: rgba(255,255,255,.75);
    font-size: 11px;
}

/* =========================
   TABS
========================= */

.tabs {
    display: none;
}

@media(max-width: 850px) {

    .workspace {
        display: block;
    }

    .editor {
        border-right: none;
    }

    .preview-area {
        padding: 20px;
    }

    .phone {
        height: 720px;
    }
}

@media(max-width: 500px) {

    .editor {
        padding: 20px;
    }

    .preview-area {
        padding: 10px;
    }

    .phone {
        width: 100%;
        height: 700px;
        border-radius: 30px;
    }

    .phone-screen {
        border-radius: 24px;
    }
}
</style>
</head>

<body>

<div class="workspace">

    <!-- =========================
         EDITOR PANEL
    ========================== -->

    <aside class="editor">

        <h1>R.G's Backyard Bistro</h1>

        <div class="editor-subtitle">
            NFC Profile Editor
        </div>

        <div class="field">
            <label>Business Name</label>
            <input
                id="businessName"
                type="text"
                value="R.G's Backyard Bistro"
            >
        </div>

        <div class="field">
            <label>Tagline</label>

            <textarea id="tagline">Your experience matters to us. We’d be delighted to hear from you. ✦</textarea>
        </div>

        <div class="field">
            <label>Google Review URL</label>

            <input
                id="reviewUrl"
                type="url"
                value="https://maps.app.goo.gl/4phPVocRoC9ZNwHf8"
            >
        </div>

        <div class="switch-row">
            <label>Google Review</label>

            <label class="switch">
                <input id="reviewEnabled" type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>

        <div class="field" style="margin-top:18px;">
            <label>Facebook URL</label>

            <input
                id="facebookUrl"
                type="url"
                value="https://www.facebook.com/profile.php?id=100090394671330"
            >
        </div>

        <div class="switch-row">
            <label>Facebook</label>

            <label class="switch">
                <input id="facebookEnabled" type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>

        <div class="field" style="margin-top:18px;">
            <label>Instagram URL</label>

            <input
                id="instagramUrl"
                type="url"
                value=""
                placeholder="https://www.instagram.com/..."
            >
        </div>

        <div class="switch-row">
            <label>Instagram</label>

            <label class="switch">
                <input id="instagramEnabled" type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>

        <div class="field" style="margin-top:18px;">
            <label>TikTok URL</label>

            <input
                id="tiktokUrl"
                type="url"
                value="https://www.tiktok.com/@backyards.bistro"
            >
        </div>

        <div class="switch-row">
            <label>TikTok</label>

            <label class="switch">
                <input id="tiktokEnabled" type="checkbox" checked>
                <span class="slider"></span>
            </label>
        </div>

        <div class="actions">

            <button
                class="save-btn"
                id="saveBtn"
            >
                Save
            </button>

            <button
                class="reset-btn"
                id="resetBtn"
            >
                Reset
            </button>

        </div>

        <div class="nfc-box">

            <strong>NFC URL</strong>

            <div
                class="nfc-url"
                id="nfcUrl"
            >
                https://yourdomain.com/rg-backyard-bistro
            </div>

            <button
                class="copy-btn"
                id="copyBtn"
            >
                Copy NFC URL
            </button>

        </div>

    </aside>


    <!-- =========================
         PHONE PREVIEW
    ========================== -->

    <main class="preview-area">

        <div class="phone">

            <div class="phone-screen">

                <div class="profile">

                    <div class="profile-content">

                        <div class="brand">

                            <h2 id="previewName">
                                R.G's Backyard Bistro
                            </h2>

                            <p id="previewTagline">
                                Your experience matters to us.
                                We’d be delighted to hear from you. ✦
                            </p>

                        </div>


                        <div
                            class="social-buttons"
                            id="socialButtons"
                        >

                            <!-- GOOGLE -->

                            <a
                                id="reviewButton"
                                class="social-button"
                                href="https://maps.app.goo.gl/4phPVocRoC9ZNwHf8"
                                target="_blank"
                            >

                                <img
                                    class="social-icon"
                                    src="image2.png"
                                    alt="Google Review"
                                >

                                <div class="social-text">

                                    <div class="social-title">
                                        Google Review
                                    </div>

                                    <div class="social-description">
                                        Share your experience with us
                                    </div>

                                </div>

                                <div class="arrow">
                                    ›
                                </div>

                            </a>


                            <!-- FACEBOOK -->

                            <a
                                id="facebookButton"
                                class="social-button"
                                href="https://www.facebook.com/profile.php?id=100090394671330"
                                target="_blank"
                            >

                                <img
                                    class="social-icon"
                                    src="image3.png"
                                    alt="Facebook"
                                >

                                <div class="social-text">

                                    <div class="social-title">
                                        Facebook
                                    </div>

                                    <div class="social-description">
                                        Follow and connect with us
                                    </div>

                                </div>

                                <div class="arrow">
                                    ›
                                </div>

                            </a>


                            <!-- INSTAGRAM -->

                            <a
                                id="instagramButton"
                                class="social-button"
                                href="#"
                                target="_blank"
                            >

                                <div
                                    class="social-icon"
                                    style="
                                    display:flex;
                                    align-items:center;
                                    justify-content:center;
                                    font-size:27px;
                                    "
                                >
                                    ◎
                                </div>

                                <div class="social-text">

                                    <div class="social-title">
                                        Instagram
                                    </div>

                                    <div class="social-description">
                                        See our photos and updates
                                    </div>

                                </div>

                                <div class="arrow">
                                    ›
                                </div>

                            </a>


                            <!-- TIKTOK -->

                            <a
                                id="tiktokButton"
                                class="social-button"
                                href="https://www.tiktok.com/@backyards.bistro"
                                target="_blank"
                            >

                                <img
                                    class="social-icon"
                                    src="image4.png"
                                    alt="TikTok"
                                >

                                <div class="social-text">

                                    <div class="social-title">
                                        TikTok
                                    </div>

                                    <div class="social-description">
                                        Follow us on TikTok
                                    </div>

                                </div>

                                <div class="arrow">
                                    ›
                                </div>

                            </a>

                        </div>


                        <div class="footer">
                            R.G's Backyard Bistro
                        </div>

                    </div>

                </div>

            </div>

        </div>

    </main>

</div>


<script>

const fields = [
    "businessName",
    "tagline",
    "reviewUrl",
    "facebookUrl",
    "instagramUrl",
    "tiktokUrl",
    "reviewEnabled",
    "facebookEnabled",
    "instagramEnabled",
    "tiktokEnabled"
];


const defaults = {

    businessName:
        "R.G's Backyard Bistro",

    tagline:
        "Your experience matters to us. We’d be delighted to hear from you. ✦",

    reviewUrl:
        "https://maps.app.goo.gl/4phPVocRoC9ZNwHf8",

    facebookUrl:
        "https://www.facebook.com/profile.php?id=100090394671330",

    instagramUrl:
        "",

    tiktokUrl:
        "https://www.tiktok.com/@backyards.bistro",

    reviewEnabled:
        true,

    facebookEnabled:
        true,

    instagramEnabled:
        true,

    tiktokEnabled:
        true
};


function values() {

    const data = {};

    fields.forEach(id => {

        const element = document.getElementById(id);

        if (
            element.type === "checkbox"
        ) {

            data[id] = element.checked;

        } else {

            data[id] = element.value;

        }

    });

    return data;
}


function load(data) {

    fields.forEach(id => {

        const element =
            document.getElementById(id);

        if (
            element.type === "checkbox"
        ) {

            element.checked =
                Boolean(data[id]);

        } else {

            element.value =
                data[id] ?? "";

        }

    });

    updatePreview();
}


function safeUrl(url) {

    try {

        const parsed =
            new URL(url);

        if (
            parsed.protocol === "http:" ||
            parsed.protocol === "https:"
        ) {

            return url;

        }

    } catch(e) {}

    return "#";
}


function updatePreview() {

    const data = values();


    document.getElementById(
        "previewName"
    ).textContent =
        data.businessName;


    document.getElementById(
        "previewTagline"
    ).textContent =
        data.tagline;


    const buttons = {

        review: document.getElementById(
            "reviewButton"
        ),

        facebook: document.getElementById(
            "facebookButton"
        ),

        instagram: document.getElementById(
            "instagramButton"
        ),

        tiktok: document.getElementById(
            "tiktokButton"
        )

    };


    buttons.review.style.display =
        data.reviewEnabled
            ? "flex"
            : "none";

    buttons.facebook.style.display =
        data.facebookEnabled
            ? "flex"
            : "none";

    buttons.instagram.style.display =
        data.instagramEnabled
            ? "flex"
            : "none";

    buttons.tiktok.style.display =
        data.tiktokEnabled
            ? "flex"
            : "none";


    buttons.review.href =
        safeUrl(data.reviewUrl);

    buttons.facebook.href =
        safeUrl(data.facebookUrl);

    buttons.instagram.href =
        safeUrl(data.instagramUrl);

    buttons.tiktok.href =
        safeUrl(data.tiktokUrl);

}


fields.forEach(id => {

    const element =
        document.getElementById(id);

    element.addEventListener(
        "input",
        updatePreview
    );

    element.addEventListener(
        "change",
        updatePreview
    );

});


document.getElementById(
    "saveBtn"
).addEventListener(
    "click",
    () => {

        localStorage.setItem(
            "rgNfcProfile",
            JSON.stringify(values())
        );

        alert(
            "Profile saved successfully."
        );

    }
);


document.getElementById(
    "resetBtn"
).addEventListener(
    "click",
    () => {

        load(defaults);

        localStorage.removeItem(
            "rgNfcProfile"
        );

    }
);


document.getElementById(
    "copyBtn"
).addEventListener(
    "click",
    async () => {

        const url =
            document.getElementById(
                "nfcUrl"
            ).textContent;

        try {

            await navigator.clipboard.writeText(
                url
            );

            alert(
                "NFC URL copied!"
            );

        } catch(e) {

            alert(
                "Unable to copy the URL."
            );

        }

    }
);


const saved =
    localStorage.getItem(
        "rgNfcProfile"
    );


if (saved) {

    try {

        load(
            JSON.parse(saved)
        );

    } catch(e) {

        load(defaults);

    }

} else {

    load(defaults);

}

</script>

</body>
</html>
